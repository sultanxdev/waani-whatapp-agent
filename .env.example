# ===================================================
# Dermatology WhatsApp AI Lead & Appointment System
# Environment Configuration
# ===================================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!

# Database Configuration (PostgreSQL / SQLite)
# For SQLite (default development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/derma_whatsapp_db?schema=public"

# WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_ACCESS_TOKEN=EAAB_sample_meta_access_token_here
WHATSAPP_VERIFY_TOKEN=clinic_whatsapp_webhook_secret_verify_token
WHATSAPP_API_VERSION=v19.0

# AI / LLM Configuration
# Optional: If not set, built-in high precision deterministic NLP engine & fallback works out-of-the-box
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Clinic Information Defaults
CLINIC_ID=clinic_derma_care_01
CLINIC_NAME="DermaCare Skin & Laser Clinic"
CLINIC_PHONE="+919876543210"
CLINIC_EMAIL="care@dermacareclinic.com"
CLINIC_ADDRESS="Suite 402, DLF Cyber City, Sector 24, Gurugram, Haryana 122002"
CLINIC_CURRENCY="INR"

# Feature Flags
# Google Docs / Sheets Dashboard Sync (Easy toggle via env)
ENABLE_GOOGLE_DOCS_SYNC=true
GOOGLE_DOCS_DOCUMENT_ID=1_sample_google_doc_id_for_clinic_knowledge_base
GOOGLE_SHEET_LEADS_DASHBOARD_ID=1_sample_google_sheet_id_for_live_lead_stream
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Auto Follow-up & Reminder Settings
ENABLE_AUTOMATED_REMINDERS=true
REMINDER_HOURS_BEFORE=24
ENABLE_AUDIT_LOGGING=true
